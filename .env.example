# ── GitHub ──────────────────────────────────────────────────────────────────
# Generate a token at: https://github.com/settings/tokens
# Required scopes: repo > contents (write)
# GitHub Personal Access Token (with 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# Gmail SMTP Configuration for alerts
# 1. GMAIL_USER: Your full gmail address
# 2. GMAIL_APP_PASSWORD: A 16-character app password from Google Security settings
#    (NOT your regular gmail password)
# 3. NOTIFY_EMAIL: Where you want the alerts sent
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_EMAIL=recipient@example.com

# Email that RECEIVES the alerts
NOTIFY_EMAIL=recipient@example.com

# ── Email subscriber signups (Google Apps Script Web App) ─────────────────────
# Deploy automation/subscribe.gs as a Web App (see README "Email signups"), then:
# SIGNUP_ENDPOINT: the deployment URL ending in /exec. It is embedded in the
#   dashboard signup form and is PUBLIC (not a secret). In GitHub Actions set this
#   as a repository VARIABLE named SIGNUP_ENDPOINT.
SIGNUP_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
# SUBSCRIBERS_TOKEN: a long random string. Set the SAME value as the LIST_TOKEN
#   script property in Apps Script. Keep it SECRET — it lets the pipeline read the
#   subscriber list. In GitHub Actions set this as a repository SECRET.
SUBSCRIBERS_TOKEN=change-me-to-a-long-random-string
