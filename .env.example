# ── GitHub ──────────────────────────────────────────────────────────────────
# Generate a token at: https://github.com/settings/tokens
# Required scopes: repo > contents (write)
# GitHub Personal Access Token (with 'repo' scope)
GH_REPO_TOKEN=your_github_token_here

# Gmail SMTP Configuration for alerts
# 1. GMAIL_USER: Your full gmail address
# 2. GMAIL_APP_PASSWORD: A 16-character app password from Google Security settings
#    (NOT your regular gmail password)
# 3. NOTIFY_EMAIL: Where you want the alerts sent
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_EMAIL=recipient@example.com

# Email that RECEIVES the alerts
NOTIFY_EMAIL=recipient@example.com

# ── Email subscriber signups (Google Apps Script Web App) ─────────────────────
# Deploy automation/subscribe.gs as a Web App (see README "Email signups"), then:
# SIGNUP_ENDPOINT: the deployment URL ending in /exec. It is embedded in the
#   dashboard signup form and is PUBLIC (not a secret). In GitHub Actions set this
#   as a repository VARIABLE named SIGNUP_ENDPOINT.
SIGNUP_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
# SUBSCRIBERS_TOKEN: a long random string. Set the SAME value as the LIST_TOKEN
#   script property in Apps Script. Keep it SECRET — it lets the pipeline read the
#   subscriber list. In GitHub Actions set this as a repository SECRET.
SUBSCRIBERS_TOKEN=change-me-to-a-long-random-string

# ── X / Twitter (@USLayoff) ──────────────────────────────────────────────────
# OAuth 1.0a user context. The app's permission must be "Read and Write".
# console.x.com → your app → Keys and tokens. These tokens do not expire, which
# is why OAuth 1.0a beats OAuth 2.0 PKCE for an unattended pipeline. App-only
# Bearer tokens CANNOT post — POST /2/tweets is user-context only.
# All four are SECRET. In GitHub Actions set them as repository SECRETS.
#
# COST: X has been pay-per-use since 2026-02-06 — there is no free tier. A post
# costs $0.015, or $0.200 if it contains a URL. At this feed's volume (~20-25
# posts/month) that is roughly $0.40/month without links or $5/month with them.
# Buy credits at console.x.com; requests are blocked at a zero balance.
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_token_secret

# X_TRANSPORT: how a post is actually sent.
#   dry     (default) compose and queue only — sends nothing, needs no keys
#   api     tweepy → POST /2/tweets, the unattended CI path
#   browser stage approved text into data/x_outbox.json for a logged-in
#           browser session, then `warn_x.py mark-posted <id> --tweet-id <id>`
X_TRANSPORT=dry

# X_AUTO_POST: "1" turns the manual review gate OFF — the pipeline approves and
#   sends its own candidates. Leave unset until the queue has been reviewed by
#   hand long enough to trust it. In GitHub Actions: a repository VARIABLE.
X_AUTO_POST=0

# X_DISABLE_POSTING: "1" is the kill switch. Honoured even in auto mode, and
#   re-checked immediately before every single post. Repository VARIABLE.
X_DISABLE_POSTING=0

# X_INCLUDE_LINK: "0" drops the dashboard link from posts, cutting the per-post
#   price from $0.200 to $0.015. Default is to include it.
X_INCLUDE_LINK=1
